# Lapor Jalan Environment Configuration
# Copy this file to .env and fill in the values

# Backend
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/lapor_jalan?schema=public

# JWT & Session (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-32-char-random-string-here
SESSION_SECRET=change-me-to-another-32-char-random-string

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# AI & ML
LLM_API_ENDPOINT=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-nvidia-api-key-here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT_MS=60000

# Vision API
VISION_API_ENDPOINT=https://api.nvidia.com/vision/analyze
VISION_API_KEY=your-nvidia-vision-api-key-here

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
