    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/session": "^10.8.0",
    "@fastify/static": "^7.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@fastify/websocket": "^8.3.0",
    "@prisma/client": "^5.16.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "fastify-plugin": "^6.0.1",
    "form-data": "^4.0.0",
