# Lapor Jalan - Frontend Environment Configuration
# For Vercel deployment, set these in Vercel Dashboard > Settings > Environment Variables

# Database (Neon.tech - free PostgreSQL, no credit card)
DATABASE_URL=postgresql://user:password@host/lapor_jalan?schema=public

# JWT & Session (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-32-char-random-string-here
SESSION_SECRET=change-me-to-another-32-char-random-string

# Frontend
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_FRONTEND_URL=https://your-app.vercel.app

# AI & ML (NVIDIA NIM)
LLM_API_ENDPOINT=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-nvidia-api-key-here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT_MS=60000

# Vision API
VISION_API_ENDPOINT=https://api.nvidia.com/vision/analyze
VISION_API_KEY=your-nvidia-vision-api-key-here

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
